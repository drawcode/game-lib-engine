<Project>
  <!-- Same practice as game-lib-bitty-base/Directory.Build.props: bin~/obj~ so no dll is ever emitted where Unity
       imports. (This folder already ends in `~`, so Unity skips it regardless; kept for parity.) -->
  <PropertyGroup>
    <BaseOutputPath>bin~\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj~\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
