<Project Sdk="Microsoft.NET.Sdk">

  <!-- Golden vector runner for the bitty view parser. Compiles ONLY Bitty.Core + MiniJSON sources, so a
       successful build proves they are engine-free. Folder ends in `~` so Unity ignores it. Run notes: see
       the header of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>bitty-vectors</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../*.cs" />
    <Compile Include="../../../../Utility/MiniJSON/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
